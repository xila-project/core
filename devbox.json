{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#nodejs_24",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#rustup",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#cargo-make",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#trunk",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#clang_multi",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#gcc_multi",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#llvmPackages.libclang.lib",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#mold",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#pkg-config",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#cmake",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#ninja",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#wayland",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#libxkbcommon",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#SDL2",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#alsa-lib",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#libGL",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#vulkan-loader",
    "github:NixOS/nixpkgs/ac62194c3917d5f474c1a844b6fd6da2db95077d#taplo",
    "github:NixOS/nixpkgs/7fd4004d0511991fff3a0524856a9be09e28c5f0#cargo-llvm-cov"
  ],
  "nixpkgs": {
    "commit": "7fd4004d0511991fff3a0524856a9be09e28c5f0"
  },
  "env": {
    "CC": "clang",
    "CXX": "clang++",
    "XILA_DEV_ROOT": "$DEVBOX_PROJECT_ROOT",
    "CARGO_HOME": "$DEVBOX_PROJECT_ROOT/.dev-environment/cargo",
    "RUSTUP_HOME": "$DEVBOX_PROJECT_ROOT/.dev-environment/rustup",
    "npm_config_cache": "$DEVBOX_PROJECT_ROOT/.dev-environment/npm-cache",
    "LIBCLANG_PATH": "$DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/lib",
    "PATH": "$DEVBOX_PROJECT_ROOT/.dev-environment/cargo/bin:$PATH"
  },
  "shell": {
    "init_hook": [
      "export RUSTUP_TOOLCHAIN=\"$XILA_RUST_TOOLCHAIN\"",
      "export LD_LIBRARY_PATH=\"$DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"",
      "export CC_wasm32_unknown_unknown=\"$(clang -print-prog-name=clang)\" CXX_wasm32_unknown_unknown=\"$(clang -print-prog-name=clang++)\"",
      "export CC_wasm32_wasip1=\"$CC_wasm32_unknown_unknown\" CXX_wasm32_wasip1=\"$CXX_wasm32_unknown_unknown\""
    ],
    "scripts": {
      "setup": [
        "[ \"$(uname -s):$(uname -m)\" = Linux:x86_64 ] || { echo \"Xila requires x86_64 Linux or WSL2.\" >&2; exit 1; }",
        "rustup toolchain install \"$XILA_RUST_TOOLCHAIN\" --profile minimal --component rustfmt,clippy",
        "rustup target add --toolchain \"$XILA_RUST_TOOLCHAIN\" wasm32-unknown-unknown wasm32-wasip1",
        "rustup toolchain install \"$XILA_NIGHTLY_TOOLCHAIN\" --profile minimal --component rust-src",
        "rustup target add --toolchain \"$XILA_NIGHTLY_TOOLCHAIN\" wasm32-unknown-unknown",
        "npm ci"
      ],
      "check": "cargo make check",
      "gui": "cargo make run -p native_example"
    }
  },
  "env_from": "development/toolchains.env"
}
